@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap');

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: 'Nunito', sans-serif;
  
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 12px;
}

#app {
  width: 100%;
  max-width: 600px;           
  background: #fff;
  border-radius: 24px;
  box-shadow: 0 8px 40px rgba(80, 0, 120, .25);
  overflow: hidden;           
}

.sc     { display: none; }   
.sc.on  { display: block; }  

.hdr {
  padding: 13px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}

.hdr-t {
  font-size: 14px;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 1px 4px rgba(0, 0, 0, .2);
}

.hdr-r {
  display: flex;
  gap: 6px;
  align-items: center;
  flex-wrap: wrap;
}

.pill {
  border-radius: 20px;
  padding: 4px 11px;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
  background: rgba(255, 255, 255, .25);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, .4);
}

.bd { padding: 14px 15px; }

.brow {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  margin-bottom: 12px;
}

.av {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;             
  border: 2px solid rgba(0, 0, 0, .1);
}

.sp {
  border-radius: 0 14px 14px 14px;
  padding: 10px 13px;
  font-size: 13px;
  line-height: 1.6;
  flex: 1;
  font-weight: 600;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  margin: 10px 0;
}

.sbox {
  border-radius: 12px;
  padding: 8px 5px;
  text-align: center;
}

.sv { font-size: 15px; font-weight: 800; }
.sl { font-size: 9px;  font-weight: 600; margin-top: 2px; opacity: .7; }

.card {
  background: #fff;
  border: 2px solid #e8e8ff;
  border-radius: 14px;
  padding: 11px 13px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 10px;
  transition: all .15s;
  user-select: none;
  margin-bottom: 7px;
  box-shadow: 0 2px 8px rgba(100, 100, 200, .07);
}

.card:hover {
  border-color: #a78bfa;
  background: #f5f3ff;
  transform: translateY(-1px);  
}

.card.sel      { border-color: #7c3aed; background: #ede9fe; }
.card.bad-pick { border-color: #ef4444; background: #fef2f2; }

.cg {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin: 10px 0;
}

.cc {
  border: 2px solid #e8e8ff;
  border-radius: 16px;
  padding: 14px 8px;
  text-align: center;
  cursor: pointer;
  transition: all .14s;
  user-select: none;
  background: #f9f8ff;
}

.cc:hover { border-color: #a78bfa; background: #f5f3ff; transform: translateY(-2px); }
.cc.sel   { border-color: #7c3aed; background: #ede9fe; box-shadow: 0 0 0 3px #c4b5fd55; }

.dg {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin: 9px 0;
}

.dc {
  border: 2px solid #e8e8ff;
  border-radius: 14px;
  padding: 10px 7px;
  text-align: center;
  cursor: pointer;
  transition: all .13s;
  user-select: none;
  background: #f9f8ff;
}

.dc:hover { border-color: #34d399; background: #ecfdf5; }
.dc.sel   { border-color: #059669; background: #d1fae5; box-shadow: 0 0 0 3px #6ee7b755; }

.sh-item {
  background: #fff;
  border: 2px solid #f0f0f0;
  border-radius: 12px;
  padding: 10px 12px;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 9px;
  cursor: pointer;
  transition: all .12s;
  user-select: none;
}

.sh-item:hover    { background: #f0fdf4; border-color: #86efac; }
.sh-item.chosen   { background: #dcfce7; border-color: #22c55e; }  
.sh-item.no-cash  { opacity: .35; cursor: not-allowed; pointer-events: none; }  

.out {
  border-radius: 14px;
  padding: 12px 14px;
  margin: 8px 0;
  font-size: 13px;
  line-height: 1.6;
  border: 2px solid;
  font-weight: 600;
}

.og { background: #dcfce7; border-color: #86efac; color: #166534; }  
.ob { background: #fee2e2; border-color: #fca5a5; color: #991b1b; }  
.oy { background: #fef3c7; border-color: #fcd34d; color: #92400e; }  
.oi { background: #dbeafe; border-color: #93c5fd; color: #1e40af; }  
.op { background: #ede9fe; border-color: #c4b5fd; color: #5b21b6; }  

.pb-w {
  background: #f0f0f0;
  border-radius: 6px;
  height: 10px;
  margin: 6px 0;
}

.pb {
  height: 10px;
  border-radius: 6px;
  background: linear-gradient(90deg, #34d399, #10b981);
  transition: width .45s;   
}

.hp-wrap {
  background: #f0f0f0;
  border-radius: 6px;
  height: 12px;
  margin: 4px 0;
  overflow: hidden;
}

.hp-bar {
  height: 12px;
  border-radius: 6px;
  transition: width .5s;
  
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 9px 18px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  border: 2px solid transparent;
  transition: all .12s;
  user-select: none;
  font-family: 'Nunito', sans-serif;
}

.btn:hover { transform: translateY(-1px); }

.btn.g { background: linear-gradient(135deg, #10b981, #059669); color: #fff; box-shadow: 0 3px 12px rgba(16,185,129,.4); }
.btn.g:hover { background: linear-gradient(135deg, #059669, #047857); }

.btn.p { background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: #fff; box-shadow: 0 3px 12px rgba(139,92,246,.4); }
.btn.p:hover { background: linear-gradient(135deg, #7c3aed, #6d28d9); }

.btn:disabled { opacity: .4; pointer-events: none; transform: none; }

.brow2 {
  display: flex;
  gap: 8px;
  margin-top: 13px;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.calc-disp {
  background: linear-gradient(135deg, #1e1b4b, #312e81);
  color: #a5f3fc;
  border-radius: 14px;
  padding: 14px 16px;
  font-size: 24px;
  font-weight: 800;
  text-align: right;
  margin: 10px 0;
  letter-spacing: 1px;
  font-family: monospace;
}

.calc-btns {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
}

.calc-btn {
  background: #f3f4f6;
  border: 2px solid #e5e7eb;
  border-radius: 10px;
  padding: 13px 6px;
  font-size: 15px;
  font-weight: 800;
  cursor: pointer;
  text-align: center;
  transition: all .12s;
  user-select: none;
  font-family: 'Nunito', sans-serif;
}

.calc-btn:hover { background: #ede9fe; border-color: #a78bfa; }
.calc-btn.op    { background: #ede9fe; color: #7c3aed; border-color: #c4b5fd; }
.calc-btn.eq    { background: linear-gradient(135deg, #10b981, #059669); color: #fff; border: none; }
.calc-btn.clr   { background: #fee2e2; color: #ef4444; border-color: #fca5a5; }

.bslider { margin: 10px 0; }

.bslider-t {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #374151;
  margin-bottom: 4px;
  font-weight: 700;
}

.bslider input[type=range] {
  width: 100%;
  accent-color: #8b5cf6;
  height: 6px;
}

.inp {
  width: 100%;
  padding: 10px 14px;
  border: 2px solid #e8e8ff;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 700;
  color: #1e1b4b;
  outline: none;
  font-family: 'Nunito', sans-serif;
}

.inp:focus { border-color: #8b5cf6; }

canvas {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 14px;
  touch-action: none;   
}

.dayflow {
  display: flex;
  align-items: center;
  gap: 4px;
  margin: 8px 0;
}

.dfs {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  flex-shrink: 0;
}

.dfd {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 2px solid #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
}

.dfd.done { border-color: #10b981; background: #dcfce7; }  
.dfd.cur  { border-color: #8b5cf6; background: #ede9fe; box-shadow: 0 0 0 3px #c4b5fd55; }  
.dfd.lk   { opacity: .3; }  

.dfl {
  flex: 1;
  height: 2px;
  background: #e0e0e0;
  margin-top: -17px;  
}

.dfl.done { background: #10b981; }

.dflbl { font-size: 9px; color: #9ca3af; font-weight: 700; }

.dream-big {
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border: 3px solid #f59e0b;
  border-radius: 16px;
  padding: 14px 16px;
  margin: 10px 0;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 4px 16px rgba(245, 158, 11, .3);
}

.dream-big-icon  { font-size: 40px; flex-shrink: 0; }
.dream-big-text  { flex: 1; }
.dream-big-title { font-size: 16px; font-weight: 900; color: #92400e; }
.dream-big-sub   { font-size: 12px; color: #b45309; margin-top: 3px; font-weight: 700; }
.dream-big-prog  { margin-top: 6px; }

.fin-ring {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  border: 5px solid #10b981;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10px;
  background: linear-gradient(135deg, #ecfdf5, #d1fae5);
}

.ddot {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 2px solid;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 800;
}

.tip-ul { list-style: none; margin: 8px 0; }

.tip-ul li {
  font-size: 13px;
  color: #374151;
  padding: 4px 0;
  display: flex;
  gap: 7px;
  font-weight: 600;
}

.tip-ul li::before {
  content: "•";
  color: #10b981;
  font-weight: 900;
  flex-shrink: 0;
}

@keyframes shk {
  0%,  100% { transform: translateX(0);   }
  25%        { transform: translateX(-4px); }
  75%        { transform: translateX(4px);  }
}

.con-box {
  border: 2px solid #ef4444;
  border-radius: 14px;
  padding: 12px 14px;
  margin: 9px 0;
  background: #fef2f2;
  font-size: 13px;
  color: #991b1b;
  font-weight: 700;
  animation: shk .3s;
}

.warn {
  background: #fef3c7;
  border: 2px solid #fcd34d;
  border-radius: 12px;
  padding: 9px 12px;
  margin: 7px 0;
  font-size: 12px;
  color: #92400e;
  font-weight: 700;
}

.slbl {
  font-size: 11px;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: .6px;
  margin: 10px 0 5px;
  font-weight: 700;
}

.title-banner {
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
  border-radius: 16px;
  padding: 14px 16px;
  margin-bottom: 12px;
  text-align: center;
  color: #fff;
}

.title-banner h1 {
  font-size: 15px;
  font-weight: 900;
  letter-spacing: .3px;
}

.bank-opt {
  border: 2px solid #e8e8ff;
  border-radius: 14px;
  padding: 11px 13px;
  cursor: pointer;
  margin-bottom: 7px;
  transition: all .13s;
  user-select: none;
  background: #f9f8ff;
}

.bank-opt:hover { border-color: #a78bfa; background: #f5f3ff; }
.bank-opt.sel   { border-color: #7c3aed; background: #ede9fe; }

.int-preview {
  background: #d1fae5;
  border-radius: 12px;
  padding: 10px 13px;
  margin: 8px 0;
  font-size: 13px;
  color: #065f46;
  font-weight: 600;
}

.hdr-intro { background: linear-gradient(135deg, #7c3aed, #4f46e5); }  
.hdr-shop  { background: linear-gradient(135deg, #ec4899, #be185d); }  
.hdr-work  { background: linear-gradient(135deg, #f59e0b, #d97706); }  
.hdr-bank  { background: linear-gradient(135deg, #10b981, #059669); }  
.hdr-ev    { background: linear-gradient(135deg, #ef4444, #dc2626); }  
.hdr-day   { background: linear-gradient(135deg, #3b82f6, #2563eb); }  
.hdr-fin   { background: linear-gradient(135deg, #f59e0b, #d97706); }
